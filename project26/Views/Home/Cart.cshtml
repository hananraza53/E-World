@{
    ViewData["Title"] = "Shopping Cart";
}

<style>
    .cart-page-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .cart-layout {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 30px;
        align-items: start;
    }

    .cart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .cart-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .cart-items-container {
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }

    .cart-item {
        display: grid;
        grid-template-columns: 120px 1fr 150px 100px;
        gap: 20px;
        padding: 25px;
        border-bottom: 1px solid #f0f0f0;
        align-items: center;
    }

    .cart-item:last-child {
        border-bottom: none;
    }

    .item-img {
        width: 100px;
        height: 100px;
        border-radius: 4px;
        overflow: hidden;
        background: #f5f5f5;
    }

    .item-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .item-details h3 {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--text-primary);
    }

    .item-details p {
        font-size: 13px;
        color: var(--text-secondary);
        margin-bottom: 12px;
    }

    .item-actions {
        display: flex;
        gap: 20px;
    }

    .action-btn {
        font-size: 13px;
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: color 0.2s;
    }

    .action-btn:hover {
        color: var(--accent-pink);
    }

    .quantity-selector {
        display: flex;
        align-items: center;
        gap: 15px;
        background: #f8f8f8;
        padding: 5px 12px;
        border-radius: 4px;
        width: fit-content;
    }

    .qty-btn {
        cursor: pointer;
        color: var(--text-secondary);
        font-size: 18px;
        font-weight: 700;
        user-select: none;
    }

    .qty-btn:hover {
        color: var(--accent-pink);
    }

    .price-tag {
        text-align: right;
    }

    .current-price {
        font-size: 18px;
        font-weight: 700;
        color: var(--accent-pink);
        display: block;
    }

    .old-price {
        font-size: 12px;
        color: var(--text-muted);
        text-decoration: line-through;
    }

    /* ── Summary Sidebar ────────────────────────────────── */
    .cart-summary {
        background: #fff;
        border-radius: 8px;
        padding: 25px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        position: sticky;
        top: 100px;
    }

    .summary-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 20px;
        color: var(--text-primary);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .summary-row.total {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #f0f0f0;
        font-size: 18px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .promo-box {
        display: flex;
        margin-top: 25px;
        gap: 10px;
    }

    .promo-box input {
        flex: 1;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 4px;
        outline: none;
        font-size: 13px;
    }

    .promo-box button {
        padding: 0 15px;
        background: #f8f8f8;
        border: 1px solid var(--border);
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

    .checkout-btn {
        width: 100%;
        margin-top: 25px;
        padding: 15px;
        background: var(--accent-pink);
        color: #fff;
        border: none;
        border-radius: 4px;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        text-transform: uppercase;
        transition: background 0.2s;
        text-align: center;
        display: block;
        text-decoration: none !important;
    }

    .checkout-btn:hover {
        background: #d74704;
        color: #fff;
    }

    .empty-cart {
        text-align: center;
        padding: 80px 20px;
        background: #fff;
        border-radius: 8px;
    }

    .empty-cart i {
        color: #e2e2e2;
        margin-bottom: 20px;
    }
</style>

<div class="cart-page-container">
    <div class="cart-header">
        <h1 class="cart-title">Shopping Cart (3 items)</h1>
        <a asp-controller="Home" asp-action="Index" class="action-btn">
            <i data-lucide="chevron-left" style="width:16px;"></i> Continue Shopping
        </a>
    </div>

    <div class="cart-layout">
        <div class="cart-main">
            <div class="cart-items-container">
                <!-- Item 1 -->
                <div class="cart-item">
                    <div class="item-img">
                        <img src="/images/mobile1.jfif" alt="Mobile">
                    </div>
                    <div class="item-details">
                        <h3>Premium Wireless Headphones - Noise Cancelling</h3>
                        <p>Color: Midnight Black | Warranty: 1 Year</p>
                        <div class="item-actions">
                            <div class="action-btn"><i data-lucide="heart" style="width:14px;"></i> Move to Wishlist</div>
                            <div class="action-btn" style="color:#ff4d4d;"><i data-lucide="trash-2" style="width:14px;"></i> Remove</div>
                        </div>
                    </div>
                    <div class="quantity-selector">
                        <span class="qty-btn">-</span>
                        <span style="font-weight:600;">1</span>
                        <span class="qty-btn">+</span>
                    </div>
                    <div class="price-tag">
                        <span class="current-price">Rs. 15,500</span>
                        <span class="old-price">Rs. 22,000</span>
                    </div>
                </div>

                <!-- Item 2 -->
                <div class="cart-item">
                    <div class="item-img">
                        <img src="/images/watch2.jfif" alt="Watch">
                    </div>
                    <div class="item-details">
                        <h3>Minimalist Analog Watch - Silver Edition</h3>
                        <p>Size: Standard | Material: Stainless Steel</p>
                        <div class="item-actions">
                            <div class="action-btn"><i data-lucide="heart" style="width:14px;"></i> Move to Wishlist</div>
                            <div class="action-btn" style="color:#ff4d4d;"><i data-lucide="trash-2" style="width:14px;"></i> Remove</div>
                        </div>
                    </div>
                    <div class="quantity-selector">
                        <span class="qty-btn">-</span>
                        <span style="font-weight:600;">2</span>
                        <span class="qty-btn">+</span>
                    </div>
                    <div class="price-tag">
                        <span class="current-price">Rs. 4,200</span>
                    </div>
                </div>

                <!-- Item 3 -->
                <div class="cart-item">
                    <div class="item-img">
                        <img src="/images/skii-pink.jpg" alt="Skin Care">
                    </div>
                    <div class="item-details">
                        <h3>Sport Running Shoes - Breathable Mesh</h3>
                        <p>Size: 42 | Color: Electric Red</p>
                        <div class="item-actions">
                            <div class="action-btn"><i data-lucide="heart" style="width:14px;"></i> Move to Wishlist</div>
                            <div class="action-btn" style="color:#ff4d4d;"><i data-lucide="trash-2" style="width:14px;"></i> Remove</div>
                        </div>
                    </div>
                    <div class="quantity-selector">
                        <span class="qty-btn">-</span>
                        <span style="font-weight:600;">1</span>
                        <span class="qty-btn">+</span>
                    </div>
                    <div class="price-tag">
                        <span class="current-price">Rs. 8,900</span>
                        <span class="old-price">Rs. 12,000</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="cart-summary">
            <h2 class="summary-title">Order Summary</h2>
            <div class="summary-row">
                <span>Subtotal (4 items)</span>
                <span>Rs. 32,800</span>
            </div>
            <div class="summary-row">
                <span>Shipping Fee</span>
                <span>Rs. 250</span>
            </div>
            <div class="summary-row">
                <span>Shipping Discount</span>
                <span style="color:#10b981;">-Rs. 250</span>
            </div>
            
            <div class="promo-box">
                <input type="text" placeholder="Enter Voucher Code">
                <button>APPLY</button>
            </div>

            <div class="summary-row total">
                <span>Total</span>
                <span style="color:var(--accent-pink);">Rs. 32,800</span>
            </div>

            <a asp-controller="Home" asp-action="Checkout" class="checkout-btn">
                Proceed to Checkout
            </a>

            <div style="margin-top:20px; text-align:center;">
                <img src="https://via.placeholder.com/250x40?text=Secure+Payment+Methods" alt="Payments" style="opacity:0.6;">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
}
