    /* Chat Footer / Input styling */
    .lc-chat-footer {
        background-color: #ffffff;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        border-top: 1px solid rgba(0, 0, 0, 0.05);
    }
    .lc-chat-input {
        width: 100%;
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.15);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 13px;
        outline: none;
        resize: none;
        transition: border-color 0.2s;
        font-family: inherit;
        line-height: 1.4;
    }
    .lc-chat-input:focus {
        border-color: #3f51b5;
    }
    .lc-send-btn {
        background-color: #3f51b5;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s, transform 0.1s;
        box-shadow: 0 2px 4px rgba(63, 81, 181, 0.2);
    }
    .lc-send-btn:hover {
        background-color: #303f9f;
    }
    .lc-send-btn:active {
        transform: scale(0.98);
    }

    /* Keyframes */
    @@keyframes lcPulse {
        0% {
            box-shadow: 0 4px 15px rgba(63, 81, 181, 0.4);
        }
        100% {
            box-shadow: 0 4px 25px rgba(63, 81, 181, 0.8), 0 0 0 10px rgba(63, 81, 181, 0);
        }
    }
    @@keyframes lcBadgeBounce {
        0% {
            transform: translateY(0);
        }
        100% {
            transform: translateY(-3px);
        }
    }
    @@keyframes lcDotPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(76, 217, 100, 0.7);
        }
        70% {
            box-shadow: 0 0 0 6px rgba(76, 217, 100, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(76, 217, 100, 0);
        }
    }
</style>

