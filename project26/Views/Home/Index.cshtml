        100% {
            transform: translateY(-3px);
        }
    }
    @@keyframes waDotPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(76, 217, 100, 0.7);
        }
        70% {
            box-shadow: 0 0 0 6px rgba(76, 217, 100, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(76, 217, 100, 0);
        }
