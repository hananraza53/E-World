@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const swiper = new Swiper('.main-swiper', {
                loop: true,
                autoplay: { delay: 5000 },
                pagination: { el: '.swiper-pagination', clickable: true },
                navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
            });
            lucide.createIcons();

            // Flash Sale Timer
            function updateTimer() {
                const now = new Date();
                const hours = 23 - now.getHours();
                const minutes = 59 - now.getMinutes();
                const seconds = 59 - now.getSeconds();

                document.getElementById('hours').textContent = hours.toString().padStart(2, '0');
                document.getElementById('minutes').textContent = minutes.toString().padStart(2, '0');
                document.getElementById('seconds').textContent = seconds.toString().padStart(2, '0');
            }
            setInterval(updateTimer, 1000);
            updateTimer();
        });

        function addToWishlist(pid) {
            if(pid === 0) return;
            fetch('/Cart/AddToWishlist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'productId=' + pid
            }).then(response => {
                if(response.redirected) {
                    window.location.href = response.url;
                    return;
                }
                return response.json();
            })
            .then(data => {
                if (data && data.success) {
                    alert(data.message);
                } else if (data) {
                    alert(data.message);
                }
            });
        }

        function buyNow(pid) {
            console.log("Buying now: " + pid);
            if(pid === 0) {
                alert('This is a demo product. Please use a real product from your shop!');
                return;
            }
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'productId=' + pid
            })
            .then(res => {
                if(res.redirected) {
                    window.location.href = res.url;
                    return;
                }
                window.location.href = '/Home/Checkout?pid=' + pid;
            })
            .catch(err => {
                console.error("Buy Now Error:", err);
                window.location.href = '/User/Login';
            });
        }

        // WhatsApp Support Configuration
        const WA_PHONE_NUMBER = "923192506226"; // Customize support number (with country code, no +, no spaces)

        function toggleWaChat(show) {
            const chatWindow = document.getElementById('waChatWindow');
            const badge = document.getElementById('waBadge');
            
            // Toggle opened state
            if (show === undefined) {
                chatWindow.classList.toggle('open');
            } else if (show) {
                chatWindow.classList.add('open');
            } else {
                chatWindow.classList.remove('open');
            }
            
            // Dismiss notification badge when opened
            if (chatWindow.classList.contains('open')) {
                if (badge) badge.style.display = 'none';
                // Save state so we don't show the badge again in this session
                sessionStorage.setItem('wa_badge_dismissed', 'true');
                
                // Focus the input
                setTimeout(() => {
                    document.getElementById('waChatInput').focus();
                }, 100);
            }
        }

        function handleWaKeydown(event) {
            // Send message on Enter (without Shift)
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendWaMessage();
            }
        }

        function sendWaMessage() {
            const inputEl = document.getElementById('waChatInput');
            const message = inputEl.value.trim();
            
            // Construct the WhatsApp URL
            // If message is empty, just direct open the chat window, otherwise send text
            let url = `https://api.whatsapp.com/send?phone=${WA_PHONE_NUMBER}`;
            if (message.length > 0) {
                url += `&text=${encodeURIComponent(message)}`;
            }
            
            // Clear input
            inputEl.value = '';
            
            // Open in a new tab/window
            window.open(url, '_blank');
            
            // Close the chat window after redirecting
            toggleWaChat(false);
        }

        // Initialize chatbox states
        document.addEventListener('DOMContentLoaded', () => {
            // Set dynamic current time in the chat bubble
            const now = new Date();
            const hours = now.getHours();
            const minutes = now.getMinutes().toString().padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            const displayHours = hours % 12 || 12;
            const timeString = `${displayHours}:${minutes} ${ampm}`;
            const timeEl = document.getElementById('waMessageTime');
            if (timeEl) {
                timeEl.textContent = timeString;
            }
            
            // Check if badge was already dismissed
            if (sessionStorage.getItem('wa_badge_dismissed') === 'true') {
                const badge = document.getElementById('waBadge');
                if (badge) badge.style.display = 'none';
            }
            
            // Auto-open chatbox after 5 seconds if not already closed/opened in past
            if (!sessionStorage.getItem('wa_chat_auto_prompted') && !sessionStorage.getItem('wa_badge_dismissed')) {
                setTimeout(() => {
                    const chatWindow = document.getElementById('waChatWindow');
                    if (chatWindow && !chatWindow.classList.contains('open')) {
                        toggleWaChat(true);
                        sessionStorage.setItem('wa_chat_auto_prompted', 'true');
                    }
                }, 5000);
            }
        });

        // ── Floating Live Chatbox Logic (Bottom-Left) ──
        let lcSessionId = localStorage.getItem('lc_chat_session_id');
        if (!lcSessionId) {
            lcSessionId = 'sess_' + Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);
            localStorage.setItem('lc_chat_session_id', lcSessionId);
        }

        let lcPollInterval = null;
        let lastLcMessageCount = 0;

        function toggleLcChat(show) {
            const chatWindow = document.getElementById('lcChatWindow');
            const badge = document.getElementById('lcBadge');
            
            if (show === undefined) {
                chatWindow.classList.toggle('open');
            } else if (show) {
                chatWindow.classList.add('open');
            } else {
                chatWindow.classList.remove('open');
            }
            
            if (chatWindow.classList.contains('open')) {
                if (badge) badge.style.display = 'none';
                sessionStorage.setItem('lc_badge_dismissed', 'true');
                
                // Load messages and start polling
                loadLcMessages();
                if (lcPollInterval) clearInterval(lcPollInterval);
                lcPollInterval = setInterval(loadLcMessages, 3000);
                
                setTimeout(() => {
                    document.getElementById('lcChatInput').focus();
                }, 100);
            } else {
                if (lcPollInterval) {
                    clearInterval(lcPollInterval);
                    lcPollInterval = null;
                }
            }
        }

        function handleLcKeydown(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendLcMessage();
            }
        }

        function loadLcMessages() {
            if (!lcSessionId) return;
            fetch(`/Chat/GetMessages?sessionId=${lcSessionId}`)
                .then(res => res.json())
                .then(data => {
                    if (data && data.success) {
                        const bodyEl = document.getElementById('lcChatBody');
                        if (!bodyEl) return;
                        
                        // Default welcome message always exists, plus database messages
                        let html = `
                            <div class="lc-message-bubble incoming">
                                <div class="lc-message-sender">Support Agent</div>
                                <div class="lc-message-text">Hello! 👋 Welcome to our Live Support. Leave us a message and an admin will reply shortly!</div>
                                <div class="lc-message-time" id="lcMessageTime">12:30 PM</div>
                            </div>
                        `;
                        
                        data.messages.forEach(m => {
                            const direction = m.isFromAdmin ? 'incoming' : 'outgoing';
                            const sender = m.isFromAdmin ? 'Admin' : m.senderName;
                            html += `
                                <div class="lc-message-bubble ${direction}">
                                    <div class="lc-message-sender">${sender}</div>
                                    <div class="lc-message-text">${m.messageText}</div>
                                    <div class="lc-message-time">${m.timestamp}</div>
                                </div>
                            `;
                        });
                        
                        const isNewMessage = data.messages.length > lastLcMessageCount;
                        bodyEl.innerHTML = html;
                        
                        // Scroll to bottom if new message arrived
                        if (isNewMessage) {
                            bodyEl.scrollTop = bodyEl.scrollHeight;
                            lastLcMessageCount = data.messages.length;
                        }
                    }
                });
        }

        function sendLcMessage() {
            const inputEl = document.getElementById('lcChatInput');
            const message = inputEl.value.trim();
            if (!message) return;
            
            fetch('/Chat/SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `sessionId=${lcSessionId}&message=${encodeURIComponent(message)}`
            })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    inputEl.value = '';
                    loadLcMessages();
                }
            });
        }

        // Setup welcome message time dynamically on load
        document.addEventListener('DOMContentLoaded', () => {
            const lcTimeEl = document.getElementById('lcMessageTime');
            if (lcTimeEl) {
                const now = new Date();
                const hours = now.getHours();
                const minutes = now.getMinutes().toString().padStart(2, '0');
                const ampm = hours >= 12 ? 'PM' : 'AM';
                const displayHours = hours % 12 || 12;
                lcTimeEl.textContent = `${displayHours}:${minutes} ${ampm}`;
            }

            // Poll message count silently when chat is closed to alert user of replies
            setInterval(() => {
                const chatWindow = document.getElementById('lcChatWindow');
                if (chatWindow && !chatWindow.classList.contains('open')) {
                    fetch(`/Chat/GetMessages?sessionId=${lcSessionId}`)
                        .then(res => res.json())
                        .then(data => {
                            if (data && data.success && data.messages.length > lastLcMessageCount) {
                                // Check if the last message is from admin
                                const lastMsg = data.messages[data.messages.length - 1];
                                if (lastMsg.isFromAdmin) {
                                    const badge = document.getElementById('lcBadge');
                                    if (badge) badge.style.display = 'flex';
                                }
                                lastLcMessageCount = data.messages.length;
                            }
                        });
                }
            }, 5000);
        });
    </script>
}