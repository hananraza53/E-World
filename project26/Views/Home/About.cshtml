@{
    ViewData["Title"] = "About E-World";
}

<style>
    .about-hero {
        height: 400px;
        background: linear-gradient(rgba(248, 86, 6, 0.85), rgba(248, 86, 6, 0.85)), url('https://images.unsplash.com/photo-1557821552-17105176677c?auto=format&fit=crop&q=80&w=2000');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #fff;
    }

    .about-container {
        max-width: 1000px;
        margin: -60px auto 60px;
        padding: 0 20px;
    }

    .about-card {
        background: #fff;
        border-radius: 8px;
        padding: 60px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    .about-section {
        margin-bottom: 50px;
    }

    .about-section h2 {
        font-size: 28px;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .about-section h2::after {
        content: '';
        flex: 1;
        height: 2px;
        background: #f0f0f0;
    }

    .about-text {
        font-size: 16px;
        line-height: 1.8;
        color: var(--text-secondary);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 40px;
    }

    .stat-item {
        text-align: center;
        padding: 30px 20px;
        background: #fdf2f2;
        border-radius: 8px;
        transition: transform 0.2s;
    }

    .stat-item:hover {
        transform: translateY(-5px);
    }

    .stat-number {
        display: block;
        font-size: 32px;
        font-weight: 800;
        color: var(--accent-pink);
        margin-bottom: 5px;
    }

    .stat-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>

<div class="about-hero">
    <div style="max-width: 800px; padding: 0 20px;">
        <h1 style="font-size: 48px; font-weight: 800; margin-bottom: 20px;">Empowering Commerce in <span style="color:#fff; text-decoration: underline;">Every World.</span></h1>
        <p style="font-size: 18px; opacity: 0.9;">E-World is Pakistan's leading online marketplace, bringing together millions of buyers and sellers.</p>
    </div>
</div>

<div class="about-container">
    <div class="about-card">
        <div class="about-section">
            <h2>Our Story</h2>
            <p class="about-text">
                Launched in 2024, E-World has grown from a small startup to the region's most trusted e-commerce platform. Our mission is to make it easy to do business anywhere in the digital world. We provide consumers with a massive collection of products from local and international brands, all delivered to your doorstep with care.
            </p>
        </div>

        <div class="about-section">
            <h2>Why Choose E-World?</h2>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 20px;">
                <div style="display: flex; gap: 15px;">
                    <div style="width: 40px; height: 40px; background: #fff8f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i data-lucide="shield-check" style="color: var(--accent-pink);"></i>
                    </div>
                    <div>
                        <h4 style="font-size: 16px; font-weight: 700; margin-bottom: 8px;">100% Authentic</h4>
                        <p style="font-size: 14px; color: var(--text-secondary);">We guarantee that all products on our platform are genuine and sourced directly from brands.</p>
                    </div>
                </div>
                <div style="display: flex; gap: 15px;">
                    <div style="width: 40px; height: 40px; background: #fff8f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i data-lucide="truck" style="color: var(--accent-pink);"></i>
                    </div>
                    <div>
                        <h4 style="font-size: 16px; font-weight: 700; margin-bottom: 8px;">Fast Delivery</h4>
                        <p style="font-size: 14px; color: var(--text-secondary);">Our logistics network ensures your orders reach you in record time, nationwide.</p>
                    </div>
                </div>
                <div style="display: flex; gap: 15px;">
                    <div style="width: 40px; height: 40px; background: #fff8f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i data-lucide="rotate-ccw" style="color: var(--accent-pink);"></i>
                    </div>
                    <div>
                        <h4 style="font-size: 16px; font-weight: 700; margin-bottom: 8px;">Easy Returns</h4>
                        <p style="font-size: 14px; color: var(--text-secondary);">Not satisfied? No problem. Return your items within 14 days for a full refund.</p>
                    </div>
                </div>
                <div style="display: flex; gap: 15px;">
                    <div style="width: 40px; height: 40px; background: #fff8f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i data-lucide="headphones" style="color: var(--accent-pink);"></i>
                    </div>
                    <div>
                        <h4 style="font-size: 16px; font-weight: 700; margin-bottom: 8px;">24/7 Support</h4>
                        <p style="font-size: 14px; color: var(--text-secondary);">Our dedicated customer care team is always here to help you with any query.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-item">
                <span class="stat-number">20M+</span>
                <span class="stat-label">Users</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">100k+</span>
                <span class="stat-label">Sellers</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">500k+</span>
                <span class="stat-label">Daily Orders</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">24/7</span>
                <span class="stat-label">Availability</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
}