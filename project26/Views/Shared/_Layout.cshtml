@inject project26.ApplicationDb.ApplicationDbContext _context
@{
    var categories = _context.Category.Take(10).ToList();
    int cartCount = 0;
    if (User.Identity.IsAuthenticated)
    {
        var userIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdStr, out int userId))
        {
            cartCount = _context.CartItems.Where(c => c.UserId == userId).Sum(c => c.Quantity);
            ViewBag.WishlistCount = _context.WishlistItems.Count(w => w.UserId == userId);
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-World</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>

    <link href="~/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        /* Daraz Top Bar */
        .top-bar {
            background: #f5f5f5;
            padding: 4px 0;
            font-size: 12px;
            color: #757575;
        }
        .top-bar .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
        }
        .top-bar-links a {
            color: #757575;
            text-decoration: none;
            margin-left: 15px;
            transition: color 0.2s;
        }
        .top-bar-links a:hover {
            color: var(--accent-pink);
        }

        /* Daraz Main Header */
        .main-header {
            background: #ffffff;
            padding: 15px 0;
            border-bottom: 1px solid #e2e2e2;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        .main-header .container {
            display: flex;
            align-items: center;
            gap: 40px;
            max-width: 1200px;
        }
        
        .brand-logo {
            font-size: 32px;
            font-weight: 800;
            color: var(--accent-pink);
            text-decoration: none !important;
            letter-spacing: -1px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .brand-logo:hover {
            color: #d74704;
        }

        /* Custom Navbar Links */
        .primary-nav {
            display: flex;
            gap: 30px;
            margin-right: 30px;
        }
        .primary-nav a {
            color: #212121;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: color 0.2s;
        }
        .primary-nav a:hover {
            color: var(--accent-pink);
        }

        .search-box {
            flex: 1;
            display: flex;
        }
        .search-box input {
            flex: 1;
            padding: 12px 20px;
            border: 2px solid var(--accent-pink);
            border-radius: 4px 0 0 4px;
            outline: none;
            font-size: 14px;
        }
        .search-box button {
            padding: 0 25px;
            background: var(--accent-pink);
            border: none;
            color: #fff;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
            transition: background 0.2s;
        }
        .search-box button:hover {
            background: #d74704;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 25px;
        }
        .action-item {
            color: #212121;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 12px;
            font-weight: 500;
            position: relative;
        }
        .action-item:hover {
            color: var(--accent-pink);
        }
        .cart-badge {
            position: absolute;
            top: -5px;
            right: -10px;
            background: var(--accent-pink);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 10px;
        }

        .category-nav {
            background: #ffffff;
            border-bottom: 1px solid #e2e2e2;
            padding: 10px 0;
            display: block; 
        }
        .category-nav .container {
            display: flex;
            gap: 20px;
            overflow-x: auto;
            max-width: 1200px;
        }
        .category-nav a {
            color: #212121;
            font-size: 14px;
            text-decoration: none;
            white-space: nowrap;
        }
        .category-nav a:hover {
            color: var(--accent-pink);
        }
    </style>
</head>
<body>

    <!-- Top Utility Bar -->
    <div class="top-bar">
        <div class="container">
            <div class="top-bar-links">
                <a href="#">Save More on App</a>
                <a href="#">Sell on E-World</a>
                <a href="#">Customer Care</a>
                <a href="#">Track my Order</a>
            </div>
            <div class="top-bar-links">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="User" asp-action="Profile">Hi, @User.Identity.Name</a>
                    <a asp-controller="Orders" asp-action="Index">My Orders</a>
                    <a asp-controller="User" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a asp-controller="User" asp-action="Login">Login</a>
                    <a asp-controller="User" asp-action="Register">Signup</a>
                }
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <header class="main-header">
        <div class="container">
            <button class="mobile-menu-btn" onclick="toggleMobileMenu(true)" aria-label="Open Menu">
                <i data-lucide="menu" style="width: 24px; height: 24px;"></i>
            </button>
            <a class="brand-logo" asp-controller="Home" asp-action="Index" style="margin-right: 20px;">
                <i data-lucide="shopping-bag" style="width:32px;height:32px;color:var(--accent-pink);"></i>
                E-World
            </a>

            <!-- Unique Navbar Links -->
            <nav class="primary-nav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="About">About</a>
                <a asp-controller="Home" asp-action="Contact">Contact</a>
                <a href="#products-section" class="scroll-link">Products</a>
            </nav>

            <form class="search-box" asp-controller="Products" asp-action="Index" method="get">
                <input type="text" name="searchQuery" placeholder="Search in E-World" />
                <button type="submit">
                    <i data-lucide="search" style="width:20px;height:20px;"></i>
                </button>
            </form>

            <div class="header-actions">
                <a asp-controller="Cart" asp-action="Wishlist" class="action-item">
                    <i data-lucide="heart" style="width:24px;height:24px;margin-bottom:2px;"></i>
                    Wishlist
                    @if(ViewBag.WishlistCount > 0) {
                        <span class="cart-badge" style="background:#2ecc71; left: -10px; right: auto;">@ViewBag.WishlistCount</span>
                    }
                </a>
                <a asp-controller="Cart" asp-action="Index" class="action-item cart-drawer-trigger">
                    <i data-lucide="shopping-cart" style="width:24px;height:24px;margin-bottom:2px;"></i>
                    Cart
                    @if(cartCount > 0) {
                        <span class="cart-badge">@cartCount</span>
                    }
                </a>
            </div>
        </div>
    </header>

    <!-- Categories Nav -->
    <div class="category-nav">
        <div class="container">
            <a asp-controller="Products" asp-action="Index" style="font-weight:700;color:var(--accent-pink);">Shop All</a>
            @if (categories != null)
            {
                @foreach (var cat in categories)
                {
                    <a asp-controller="Products" asp-action="Index" asp-route-category="@cat.cname">@cat.cname</a>
                }
            }
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="custom-footer">
        <div class="container footer-grid">
            <div class="footer-col">
                <h4>Customer Care</h4>
                <div class="footer-links">
                    <a href="#">Help Center</a>
                    <a href="#">How to Buy</a>
                    <a href="#">Returns & Refunds</a>
                    <a href="#">Contact Us</a>
                </div>
            </div>
            <div class="footer-col">
                <h4>E-World</h4>
                <div class="footer-links">
                    <a asp-controller="Home" asp-action="About">About E-World</a>
                    <a href="#">Careers</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a href="#">Terms & Conditions</a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Earn With E-World</h4>
                <div class="footer-links">
                    <a href="#">Sell on E-World</a>
                    <a href="#">Affiliate Program</a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Payment Methods</h4>
                <div style="display:flex;gap:10px;margin-top:10px;">
                    <i data-lucide="credit-card" style="width:32px;height:32px;color:#9e9e9e;"></i>
                    <i data-lucide="wallet" style="width:32px;height:32px;color:#9e9e9e;"></i>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            &copy; 2026 E-World. All rights reserved.
        </div>
    </footer>

    <!-- Mobile Navigation Drawer -->
    <div id="mobileMenuOverlay" class="mobile-menu-overlay" onclick="toggleMobileMenu(false)"></div>
    <div id="mobileMenu" class="mobile-menu-drawer">
        <div class="mobile-menu-header">
            <div class="brand-logo">
                <i data-lucide="shopping-bag" style="width:28px;height:28px;color:var(--accent-pink);"></i>
                E-World
            </div>
            <button class="close-menu-btn" onclick="toggleMobileMenu(false)" aria-label="Close Menu">
                <i data-lucide="x" style="width:24px; height:24px;"></i>
            </button>
        </div>
        <div class="mobile-menu-body">
            <div class="mobile-menu-section">
                <h4>Navigation</h4>
                <a asp-controller="Home" asp-action="Index" onclick="toggleMobileMenu(false)"><i data-lucide="home" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;"></i>Home</a>
                <a asp-controller="Home" asp-action="About" onclick="toggleMobileMenu(false)"><i data-lucide="info" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;"></i>About Us</a>
                <a asp-controller="Home" asp-action="Contact" onclick="toggleMobileMenu(false)"><i data-lucide="phone" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;"></i>Contact Us</a>
                <a asp-controller="Products" asp-action="Index" onclick="toggleMobileMenu(false)"><i data-lucide="shopping-bag" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;"></i>All Products</a>
            </div>
            
            <div class="mobile-menu-section">
                <h4>Categories</h4>
                @if (categories != null)
                {
                    @foreach (var cat in categories.Take(8))
                    {
                        <a asp-controller="Products" asp-action="Index" asp-route-category="@cat.cname" onclick="toggleMobileMenu(false)">@cat.cname</a>
                    }
                }
            </div>

            <div class="mobile-menu-section user-section">
                <h4>My Account</h4>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="User" asp-action="Profile" onclick="toggleMobileMenu(false)"><i data-lucide="user" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;"></i>My Profile</a>
                    <a asp-controller="Orders" asp-action="Index" onclick="toggleMobileMenu(false)"><i data-lucide="package" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;"></i>My Orders</a>
                    <a asp-controller="User" asp-action="Logout" class="logout-link" onclick="toggleMobileMenu(false)"><i data-lucide="log-out" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;"></i>Logout</a>
                }
                else
                {
                    <a asp-controller="User" asp-action="Login" onclick="toggleMobileMenu(false)"><i data-lucide="log-in" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;"></i>Login</a>
                    <a asp-controller="User" asp-action="Register" onclick="toggleMobileMenu(false)"><i data-lucide="user-plus" style="width:16px;height:16px;vertical-align:middle;margin-right:8px;"></i>Signup</a>
                }
            </div>
        </div>
    </div>

    <!-- Cart Drawer Sidebar -->
    <div id="cartDrawerOverlay" class="cart-drawer-overlay"></div>
    <div id="cartDrawer" class="cart-drawer">
        <div class="cart-drawer-header">
            <h3>Shopping Cart</h3>
            <button class="close-drawer" onclick="toggleCartDrawer(false)">
                <i data-lucide="x" style="width:24px; height:24px;"></i>
            </button>
        </div>
        <div id="cartDrawerItems" class="cart-drawer-body">
            <!-- Items will be loaded here via AJAX -->
            <div class="drawer-loading">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        </div>
        <div class="cart-drawer-footer">
            <div class="drawer-subtotal">
                <span>Subtotal</span>
                <span id="drawerSubtotal">Rs. 0</span>
            </div>
            <div class="drawer-actions">
                <a asp-controller="Cart" asp-action="Index" class="btn-drawer btn-view-cart">View Cart</a>
                <a asp-controller="Home" asp-action="Checkout" class="btn-drawer btn-checkout">Checkout Now</a>
            </div>
        </div>
    </div>

    <style>
        .cart-drawer-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1999;
            display: none;
            backdrop-filter: blur(2px);
        }
        .cart-drawer {
            position: fixed;
            top: 0;
            right: -400px;
            width: 400px;
            height: 100%;
            background: #fff;
            z-index: 2000;
            transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            box-shadow: -5px 0 15px rgba(0,0,0,0.1);
        }
        .cart-drawer.open { right: 0; }
        .cart-drawer-header {
            padding: 20px;
            border-bottom: 1px solid #eff0f5;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .cart-drawer-header h3 { font-size: 18px; margin: 0; font-weight: 700; }
        .close-drawer { background: none; border: none; cursor: pointer; color: #212121; }
        
        .cart-drawer-body { flex: 1; overflow-y: auto; padding: 15px; }
        .drawer-item { display: flex; gap: 12px; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #f8f8f8; }
        .drawer-item-img { width: 70px; height: 70px; border-radius: 4px; object-fit: cover; background: #f5f5f5; }
        .drawer-item-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }
        .drawer-item-name { font-size: 13px; font-weight: 600; color: #212121; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-decoration: none; }
        .drawer-item-price { font-size: 14px; color: var(--daraz-orange, #f85606); font-weight: 700; margin-bottom: 8px; }
        
        .drawer-item-controls { display: flex; justify-content: space-between; align-items: center; }
        .drawer-qty-box { display: flex; align-items: center; background: #f5f5f5; border-radius: 4px; padding: 2px; }
        .qty-btn-mini { background: none; border: none; width: 24px; height: 24px; cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center; color: #757575; }
        .qty-btn-mini:hover { color: var(--accent-pink); }
        .qty-val { min-width: 20px; text-align: center; font-size: 13px; font-weight: 600; }
        .drawer-remove-btn { background: none; border: none; cursor: pointer; color: #9e9e9e; transition: color 0.2s; padding: 5px; }
        .drawer-remove-btn:hover { color: #ff4d4d; }

        .cart-drawer-footer { padding: 20px; border-top: 1px solid #eff0f5; background: #fafafa; }
        .drawer-subtotal { display: flex; justify-content: space-between; font-size: 16px; font-weight: 700; margin-bottom: 20px; }
        .drawer-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .btn-drawer { padding: 12px; text-align: center; border-radius: 4px; text-decoration: none !important; font-weight: 700; font-size: 13px; text-transform: uppercase; }
        .btn-view-cart { background: #fff; color: #212121; border: 1px solid #e2e2e2; }
        .btn-checkout { background: var(--accent-pink); color: #fff; border: none; }
        
        .drawer-loading { display: flex; justify-content: center; align-items: center; height: 100px; }
        .empty-drawer { text-align: center; padding: 40px 0; color: #757575; }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            
            // Re-bind cart toggle
            document.querySelectorAll('.cart-drawer-trigger').forEach(el => {
                el.addEventListener('click', (e) => {
                    e.preventDefault();
                    toggleCartDrawer(true);
                });
            });
        });

        function toggleCartDrawer(open) {
            const drawer = document.getElementById('cartDrawer');
            const overlay = document.getElementById('cartDrawerOverlay');
            if (open) {
                drawer.classList.add('open');
                overlay.style.display = 'block';
                loadCartDrawer();
            } else {
                drawer.classList.remove('open');
                overlay.style.display = 'none';
            }
        }

        document.getElementById('cartDrawerOverlay').addEventListener('click', () => toggleCartDrawer(false));

        function toggleMobileMenu(open) {
            const drawer = document.getElementById('mobileMenu');
            const overlay = document.getElementById('mobileMenuOverlay');
            if (open) {
                drawer.classList.add('open');
                overlay.classList.add('open');
            } else {
                drawer.classList.remove('open');
                overlay.classList.remove('open');
            }
        }

        function loadCartDrawer() {
            const container = document.getElementById('cartDrawerItems');
            const subtotalEl = document.getElementById('drawerSubtotal');
            
            fetch('/Cart/GetCartItemsJson')
                .then(res => res.json())
                .then(data => {
                    if (data.items && data.items.length > 0) {
                        let html = '';
                        let subtotal = 0;
                        data.items.forEach(item => {
                            const price = item.pdis > 0 ? item.pdisprice : item.pprice;
                            subtotal += price * item.quantity;
                            html += `
                                <div class="drawer-item" id="drawer-item-${item.productId}">
                                    <img src="${item.imageUrl || '/images/mobile1.jfif'}" class="drawer-item-img">
                                    <div class="drawer-item-info">
                                        <a href="/Products/Details/${item.productId}" class="drawer-item-name">${item.pname}</a>
                                        <div class="drawer-item-price">Rs. ${price}</div>
                                        <div class="drawer-item-controls">
                                            <div class="drawer-qty-box">
                                                <button class="qty-btn-mini" onclick="updateDrawerQty(${item.productId}, -1)">-</button>
                                                <span class="qty-val">${item.quantity}</span>
                                                <button class="qty-btn-mini" onclick="updateDrawerQty(${item.productId}, 1)">+</button>
                                            </div>
                                            <button class="drawer-remove-btn" onclick="removeFromDrawer(${item.productId})">
                                                <i data-lucide="trash-2" style="width:16px; height:16px;"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });
                        container.innerHTML = html;
                        subtotalEl.textContent = 'Rs. ' + subtotal;
                        lucide.createIcons(); // Refresh icons for the trash bin
                    } else {
                        container.innerHTML = '<div class="empty-drawer"><i data-lucide="shopping-bag" style="width:48px;height:48px;margin-bottom:10px;"></i><p>Your cart is empty</p></div>';
                        subtotalEl.textContent = 'Rs. 0';
                        lucide.createIcons();
                    }
                });
        }

        function updateDrawerQty(pid, delta) {
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${pid}&quantity=${delta}`
            }).then(() => loadCartDrawer());
        }

        function removeFromDrawer(pid) {
            fetch('/Cart/RemoveFromCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${pid}`
            }).then(() => loadCartDrawer());
        }

        // Global AddToCart function
        function addToCart(pid, qty = 1) {
            console.log("Adding to cart: " + pid);
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${pid}&quantity=${qty}`
            })
            .then(res => {
                if(res.redirected) {
                    window.location.href = res.url;
                    return;
                }
                return res.json();
            })
            .then(data => {
                if(data && data.success) {
                    // Update header badge if needed (optional since we're opening drawer)
                    toggleCartDrawer(true);
                } else if(data) {
                    alert(data.message || 'Error adding to cart');
                }
            })
            .catch(err => {
                window.location.href = '/User/Login';
            });
        }

        // Smooth scroll for anchor links
        document.querySelectorAll('.scroll-link').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                if(document.getElementById('products-section')) {
                    e.preventDefault();
                    document.getElementById('products-section').scrollIntoView({
                        behavior: 'smooth'
                    });
                } else {
                    window.location.href = '/Home/Index#products-section';
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>