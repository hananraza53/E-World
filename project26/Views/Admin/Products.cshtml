@model IEnumerable<project26.Models.Product>
@inject project26.ApplicationDb.ApplicationDbContext _context
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products Management";
    var categories = _context.Category.ToList();
    
    var localImages = new List<string> { 
        "/images/mobile1.jfif", "/images/mobile2.png", 
        "/images/skii-pink.jpg", "/images/skin.webp", 
        "/images/skin2.jpeg", "/images/skin3.webp", 
        "/images/skin4.webp", "/images/watch1.webp", 
        "/images/watch2.jfif" 
    };
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-block">
        <h1 class="page-title">Inventory Management</h1>
        <p class="page-subtitle">Track stock, prices and product details across your shop.</p>
    </div>
    <button class="btn-primary" onclick="openProductModal('add')">
        <i data-lucide="package-plus" style="width:16px;height:16px;"></i>
        Add New Product
    </button>
</div>

<!-- Stats Strip -->
<div class="crud-stat-strip">
    <div class="crud-stat">
        <span class="crud-stat-val">@Model.Count()</span>
        <span class="crud-stat-label">Total Products</span>
    </div>
    <div class="crud-stat">
        <span class="crud-stat-val" style="color:var(--accent-green);">@Model.Count(p => p.pqty > 5)</span>
        <span class="crud-stat-label">In Stock</span>
    </div>
    <div class="crud-stat">
        <span class="crud-stat-val" style="color:var(--accent-pink);">@Model.Count(p => p.pqty <= 5)</span>
        <span class="crud-stat-label">Low Stock</span>
    </div>
</div>

<!-- Toolbar -->
<div class="crud-toolbar">
    <div class="header-search" style="flex:1; max-width:400px;">
        <i data-lucide="search" class="search-icon"></i>
        <input type="text" placeholder="Search by name, ID or category..." class="search-input" id="prod-search" oninput="filterProducts()" />
    </div>
    <select class="time-select" id="prod-sort" onchange="filterProducts()">
        <option value="newest">Sort: Newest</option>
        <option value="oldest">Sort: Oldest</option>
        <option value="price-low">Price: Low to High</option>
        <option value="price-high">Price: High to Low</option>
    </select>
</div>

<!-- Table -->
<div class="panel" style="padding:0; overflow:hidden;">
    <div class="table-wrap">
        <table class="orders-table">
            <thead>
                <tr>
                    <th style="width:80px;">PID</th>
                    <th style="text-align:left;">PRODUCT DETAILS</th>
                    <th>CATEGORY</th>
                    <th>STOCK</th>
                    <th>PRICE (DISC.)</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody id="prod-tbody">
                <!-- Dynamic Rows via JS -->
            </tbody>
        </table>
    </div>
</div>

<!-- ── ADD / EDIT MODAL ───────────────────────────────────── -->
<div class="modal-overlay" id="prod-modal" onclick="closeProductModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()" style="max-width:900px; width:95%;">
        <div class="modal-header">
            <h3 class="modal-title" id="prod-modal-title">Add Product</h3>
            <button class="modal-close" onclick="closeProductModal(null)"><i data-lucide="x"></i></button>
        </div>
        <form id="prod-form" onsubmit="saveProduct(event)">
            <input type="hidden" id="prod-edit-id" value="0" />
            
            <div class="product-modal-grid">
                
                <div class="form-column">
                    <label class="form-label">Product Image</label>
                    <input type="file" id="prod-file-input" accept="image/*" style="display:none;" onchange="handleProdFile(this)" />
                    
                    <div class="file-upload-area" id="prod-upload-area" onclick="document.getElementById('prod-file-input').click()" style="height:220px; border-style:dashed; background:#fafafa;">
                        <div id="prod-upload-placeholder">
                            <i data-lucide="cloud-upload" style="width:40px;height:40px;color:var(--accent-pink);margin-bottom:10px;"></i>
                            <p style="font-size:0.8rem; font-weight:700;">Upload New Image</p>
                        </div>
                        <div id="prod-img-preview-wrap" style="display:none;width:100%;height:100%;">
                            <img id="prod-img-preview" src="" style="width:100%;height:100%;object-fit:contain;border-radius:8px;" />
                        </div>
                    </div>

                    <div style="margin-top:20px;">
                        <label class="form-label">Or Selection Local Asset</label>
                        <div class="local-images-grid">
                            @foreach(var img in localImages)
                            {
                                <div class="local-img-pick" onclick="pickLocalImage('@img')" style="cursor:pointer; border:2px solid transparent; border-radius:6px; overflow:hidden; aspect-ratio:1;">
                                    <img src="@img" style="width:100%; height:100%; object-fit:cover;" />
                                </div>
                            }
                        </div>
                        <input type="hidden" id="prod-local-url" value="" />
                    </div>
                </div>

                <div class="form-column">
                    <div class="form-grid">
                        <div class="form-group" style="grid-column: span 2;">
                            <label class="form-label">Full Product Name</label>
                            <input type="text" class="form-input" id="prod-name" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Category</label>
                            <select class="form-input" id="prod-category" required>
                                @foreach(var cat in categories)
                                {
                                    <option value="@cat.cid">@cat.cname</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Stock Quantity</label>
                            <input type="number" class="form-input" id="prod-qty" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Price (Rs.)</label>
                            <input type="number" class="form-input" id="prod-price" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Discount (%)</label>
                            <input type="number" class="form-input" id="prod-dis" value="0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Size</label>
                            <input type="text" class="form-input" id="prod-size" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Color</label>
                            <input type="text" class="form-input" id="prod-color" />
                        </div>
                        <div class="form-group" style="grid-column: span 2;">
                            <label class="form-label">Description</label>
                            <textarea class="form-input" id="prod-des" rows="4"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-ghost" onclick="closeProductModal(null)">Cancel</button>
                <button type="submit" class="btn-primary" id="prod-save-btn">Save Product</button>
            </div>
        </form>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal-overlay" id="prod-delete-modal" onclick="closeProductDeleteModal(event)">
    <div class="modal-box modal-sm" onclick="event.stopPropagation()">
        <div class="delete-icon-wrap">
            <i data-lucide="alert-triangle" style="width:32px;height:32px;color:var(--accent-pink);"></i>
        </div>
        <h3 class="modal-title" style="text-align:center;">Delete Product?</h3>
        <p id="prod-del-name" style="text-align:center;font-weight:700;color:var(--accent-pink);margin-bottom:20px;"></p>
        <input type="hidden" id="prod-delete-id" />
        <div class="modal-footer" style="justify-content:center; border:none;">
            <button class="btn-ghost" onclick="closeProductDeleteModal(null)">Cancel</button>
            <button class="btn-danger" onclick="confirmProductDelete()">Delete</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let products = [];

    async function loadProducts() {
        const response = await fetch('/Products/GetProducts');
        products = await response.json();
        renderAdminProducts(products);
    }

    function renderAdminProducts(data) {
        const tbody = document.getElementById('prod-tbody');
        tbody.innerHTML = data.map(p => `
            <tr>
                <td class="order-id">#${p.pid}</td>
                <td style="text-align:left;">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <img src="${p.imageUrl || '/images/mobile1.jfif'}" style="width:45px; height:45px; border-radius:8px; object-fit:cover;" />
                        <div style="font-weight:700; color:var(--text-primary);">${p.pname}</div>
                    </div>
                </td>
                <td><span class="badge" style="background:rgba(248,86,6,0.1); color:var(--accent-pink);">${p.categoryName}</span></td>
                <td><div style="font-weight:600;">${p.pqty} Units</div></td>
                <td>
                    <div style="font-weight:800; color:var(--text-primary);">Rs. ${p.pdisprice || p.pprice}</div>
                </td>
                <td>
                    <div style="display:flex; gap:8px; justify-content:center;">
                        <button class="action-btn action-edit" onclick="openProductModal('edit', ${p.pid})"><i data-lucide="edit-3" style="width:14px;"></i></button>
                        <button class="action-btn action-delete" onclick="openProductDeleteModal(${p.pid}, '${p.pname.replace(/'/g,"\\'")}')"><i data-lucide="trash-2" style="width:14px;"></i></button>
                    </div>
                </td>
            </tr>
        `).join('');
        lucide.createIcons();
    }

    function filterProducts() {
        const q = document.getElementById('prod-search').value.toLowerCase();
        const sort = document.getElementById('prod-sort').value;
        let filtered = products.filter(p => p.pname.toLowerCase().includes(q) || p.categoryName.toLowerCase().includes(q));
        if (sort === 'newest') filtered.sort((a,b) => b.pid - a.pid);
        if (sort === 'oldest') filtered.sort((a,b) => a.pid - b.pid);
        renderAdminProducts(filtered);
    }

    function openProductModal(mode, pid) {
        document.getElementById('prod-modal').classList.add('open');
        document.getElementById('prod-form').reset();
        document.getElementById('prod-img-preview-wrap').style.display = 'none';
        document.getElementById('prod-upload-placeholder').style.display = 'flex';
        if (mode === 'edit') {
            const p = products.find(x => x.pid === pid);
            document.getElementById('prod-edit-id').value = p.pid;
            document.getElementById('prod-name').value = p.pname;
            document.getElementById('prod-category').value = p.Categoryid;
            document.getElementById('prod-price').value = p.pprice;
            document.getElementById('prod-dis').value = p.pdis;
            document.getElementById('prod-qty').value = p.pqty;
            document.getElementById('prod-des').value = p.pdes;
            if (p.imageUrl) {
                document.getElementById('prod-img-preview').src = p.imageUrl;
                document.getElementById('prod-img-preview-wrap').style.display = 'block';
                document.getElementById('prod-upload-placeholder').style.display = 'none';
            }
        }
        lucide.createIcons();
    }

    function closeProductModal(e) { if (!e || e.target === document.getElementById('prod-modal')) document.getElementById('prod-modal').classList.remove('open'); }

    function handleProdFile(input) {
        const file = input.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                document.getElementById('prod-img-preview').src = e.target.result;
                document.getElementById('prod-img-preview-wrap').style.display = 'block';
                document.getElementById('prod-upload-placeholder').style.display = 'none';
            };
            reader.readAsDataURL(file);
        }
    }

    function pickLocalImage(url) {
        document.getElementById('prod-local-url').value = url;
        document.getElementById('prod-img-preview').src = url;
        document.getElementById('prod-img-preview-wrap').style.display = 'block';
        document.getElementById('prod-upload-placeholder').style.display = 'none';
    }

    async function saveProduct(e) {
        e.preventDefault();
        const formData = new FormData();
        formData.append('pid', document.getElementById('prod-edit-id').value);
        formData.append('pname', document.getElementById('prod-name').value);
        formData.append('Categoryid', document.getElementById('prod-category').value);
        formData.append('pprice', document.getElementById('prod-price').value);
        formData.append('pdis', document.getElementById('prod-dis').value);
        formData.append('pqty', document.getElementById('prod-qty').value);
        formData.append('pdes', document.getElementById('prod-des').value);
        formData.append('selectedSize', document.getElementById('prod-size').value);
        formData.append('selectedColor', document.getElementById('prod-color').value);
        formData.append('localImageUrl', document.getElementById('prod-local-url').value);
        const file = document.getElementById('prod-file-input').files[0];
        if (file) formData.append('imageFile', file);

        await fetch('/Products/Save', { method: 'POST', body: formData });
        closeProductModal(null);
        loadProducts();
    }

    function openProductDeleteModal(id, name) {
        document.getElementById('prod-delete-id').value = id;
        document.getElementById('prod-del-name').textContent = name;
        document.getElementById('prod-delete-modal').classList.add('open');
    }

    function closeProductDeleteModal(e) { if (!e || e.target === document.getElementById('prod-delete-modal')) document.getElementById('prod-delete-modal').classList.remove('open'); }

    async function confirmProductDelete() {
        const id = document.getElementById('prod-delete-id').value;
        await fetch(`/Products/Delete/${id}`, { method: 'POST' });
        closeProductDeleteModal(null);
        loadProducts();
    }

    document.addEventListener('DOMContentLoaded', loadProducts);
</script>
}
