@{
    ViewData["Title"] = "Live Support Chats";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .admin-chat-container {
        display: grid;
        grid-template-columns: 320px 1fr;
        height: calc(100vh - 140px);
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e2e2;
        overflow: hidden;
        margin-top: 10px;
    }

    /* Sessions Panel */
    .chat-sessions-panel {
        border-right: 1px solid #e2e2e2;
        display: flex;
        flex-direction: column;
        background: #fcfcfc;
    }
    .panel-header {
        padding: 20px;
        border-bottom: 1px solid #e2e2e2;
        font-weight: 700;
        font-size: 16px;
        color: #212121;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .sessions-list {
        flex: 1;
        overflow-y: auto;
    }
    .session-item {
        padding: 15px 20px;
        border-bottom: 1px solid #f1f1f1;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .session-item:hover {
        background: #f5f5f5;
    }
    .session-item.active {
        background: #eef5f4;
        border-left: 4px solid #075e54;
    }
    .session-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .session-user {
        font-weight: 600;
        font-size: 13.5px;
        color: #212121;
    }
    .session-time {
        font-size: 11px;
        color: #9e9e9e;
    }
    .session-body {
        font-size: 12.5px;
        color: #757575;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Chat Messages Panel */
    .chat-messages-panel {
        display: flex;
        flex-direction: column;
        background: #e5ddd5;
        background-image: url('https://user-images.githubusercontent.com/15075759/28719144-86dc0f70-73b1-11e7-911d-60d70fcded21.png');
        background-repeat: repeat;
        background-size: 400px;
    }
    .active-chat-header {
        background: #ffffff;
        padding: 15px 20px;
        border-bottom: 1px solid #e2e2e2;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }
    .active-user-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #075e54;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 16px;
    }
    .active-user-name {
        font-weight: 600;
        color: #212121;
        font-size: 15px;
    }
    .active-user-status {
        font-size: 11px;
        color: #2ecc71;
        font-weight: 500;
    }
    
    .messages-thread {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .msg-row {
        display: flex;
        width: 100%;
    }
    .msg-row.incoming {
        justify-content: flex-start;
    }
    .msg-row.outgoing {
        justify-content: flex-end;
    }
    .msg-bubble {
        max-width: 60%;
        padding: 10px 14px;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        font-size: 13.5px;
        line-height: 1.4;
    }
    .msg-row.incoming .msg-bubble {
        background: #ffffff;
        color: #212121;
        border-top-left-radius: 0;
    }
    .msg-row.outgoing .msg-bubble {
        background: #dcf8c6;
        color: #212121;
        border-top-right-radius: 0;
    }
    .msg-meta {
        font-size: 10px;
        color: #888888;
        margin-top: 4px;
        text-align: right;
        display: flex;
        justify-content: flex-end;
        gap: 4px;
    }

    /* Input area */
    .chat-reply-footer {
        background: #f0f0f0;
        padding: 15px 20px;
        border-top: 1px solid #e2e2e2;
        display: flex;
        gap: 12px;
        align-items: center;
    }
    .chat-reply-input {
        flex: 1;
        background: #ffffff;
        border: 1px solid #e2e2e2;
        border-radius: 20px;
        padding: 10px 18px;
        font-size: 14px;
        outline: none;
        resize: none;
        max-height: 80px;
        font-family: inherit;
    }
    .chat-reply-input:focus {
        border-color: #075e54;
    }
    .chat-send-btn {
        background: #075e54;
        color: #ffffff;
        border: none;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
        box-shadow: 0 2px 5px rgba(7, 94, 84, 0.2);
    }
    .chat-send-btn:hover {
        background: #054d44;
    }
    .chat-send-btn:active {
        transform: scale(0.95);
    }

    .no-chat-selected {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #f4f5f7;
        color: #757575;
        gap: 15px;
    .chat-back-btn {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        color: #757575;
        padding: 6px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: background 0.2s;
    }
    .chat-back-btn:hover {
        background: rgba(0, 0, 0, 0.05);
    }

    @@media (max-width: 768px) {
        .admin-chat-container {
            grid-template-columns: 1fr;
            height: calc(100vh - 120px);
        }
        
        /* Show only conversation list by default on mobile */
        .admin-chat-container:not(.has-active-chat) .chat-messages-panel {
            display: none;
        }
        .admin-chat-container:not(.has-active-chat) .chat-sessions-panel {
            display: flex;
            width: 100%;
        }

        /* Show only chat window when active */
        .admin-chat-container.has-active-chat .chat-sessions-panel {
            display: none;
        }
        .admin-chat-container.has-active-chat .chat-messages-panel {
            display: flex;
            width: 100%;
        }
        
        .chat-back-btn {
            display: flex !important;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0" style="font-weight:700; color: #212121;">Live Support Chats</h2>
</div>

<div class="admin-chat-container">
    <!-- Left panel: Sessions -->
    <div class="chat-sessions-panel">
        <div class="panel-header">
            <i data-lucide="message-square" style="width:20px; height:20px; color:#075e54;"></i>
            <span>Active Conversations</span>
        </div>
        <div class="sessions-list" id="sessionsList">
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-success mb-2" role="status"></div>
                <div>Loading conversations...</div>
            </div>
        </div>
    </div>

    <!-- Right panel: Active Thread -->
    <div class="chat-messages-panel" id="chatMessagesPanel">
        <div class="no-chat-selected">
            <i data-lucide="messages-square" style="width:64px; height:64px; color:#c1c1c1;"></i>
            <h4>Select a conversation to start chatting</h4>
            <p class="text-muted">Live customer support queries will appear here.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSessionId = "";
        let pollInterval = null;

        document.addEventListener('DOMContentLoaded', () => {
            loadSessions();
            // Poll sessions list every 5 seconds
            setInterval(loadSessions, 5000);
        });

        function loadSessions() {
            fetch('/Admin/GetChatSessions')
                .then(res => res.json())
                .then(data => {
                    const listEl = document.getElementById('sessionsList');
                    if (data && data.length > 0) {
                        let html = '';
                        data.forEach(s => {
                            const isActive = s.sessionId === currentSessionId ? 'active' : '';
                            html += `
                                <div class="session-item ${isActive}" onclick="selectSession('${s.sessionId}', '${s.senderName}')">
                                    <div class="session-top">
                                        <span class="session-user">${s.senderName}</span>
                                        <span class="session-time">${s.timestamp}</span>
                                    </div>
                                    <div class="session-body">${s.lastMessageText}</div>
                                </div>
                            `;
                        });
                        listEl.innerHTML = html;
                    } else {
                        listEl.innerHTML = '<div class="text-center py-5 text-muted"><p>No active conversations</p></div>';
                    }
                });
        }

        function selectSession(sessionId, senderName) {
            currentSessionId = sessionId;
            
            // Highlight in list
            document.querySelectorAll('.session-item').forEach(item => {
                item.classList.remove('active');
            });
            event?.currentTarget?.classList.add('active');

            // Add active chat class for mobile layout
            document.querySelector('.admin-chat-container').classList.add('has-active-chat');

            // Render Thread UI
            const panelEl = document.getElementById('chatMessagesPanel');
            panelEl.innerHTML = `
                <div class="active-chat-header">
                    <button class="chat-back-btn" onclick="backToSessions()" aria-label="Back to Conversations">
                        <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
                    </button>
                    <div class="active-user-avatar">${senderName.charAt(0).toUpperCase()}</div>
                    <div>
                        <div class="active-user-name">${senderName}</div>
                        <div class="active-user-status">Customer is Online</div>
                    </div>
                </div>
                <div class="messages-thread" id="messagesThread">
                    <!-- Loaded via AJAX -->
                </div>
                <div class="chat-reply-footer">
                    <textarea class="chat-reply-input" id="replyInput" placeholder="Type a reply..." rows="1" onkeydown="handleReplyKeydown(event)"></textarea>
                    <button class="chat-send-btn" onclick="sendReply()">
                        <i data-lucide="send" style="width:18px; height:18px;"></i>
                    </button>
                </div>
            `;
            lucide.createIcons();

            // Load and poll messages
            loadMessages();
            if (pollInterval) clearInterval(pollInterval);
            pollInterval = setInterval(loadMessages, 3000);
        }

        function backToSessions() {
            currentSessionId = "";
            if (pollInterval) clearInterval(pollInterval);
            document.querySelector('.admin-chat-container').classList.remove('has-active-chat');
            loadSessions();
        }

        function loadMessages() {
            if (!currentSessionId) return;
            fetch(`/Admin/GetSessionMessages?sessionId=${currentSessionId}`)
                .then(res => res.json())
                .then(data => {
                    const threadEl = document.getElementById('messagesThread');
                    if (!threadEl) return;
                    
                    const wasScrolledToBottom = threadEl.scrollHeight - threadEl.clientHeight <= threadEl.scrollTop + 50;

                    let html = '';
                    data.forEach(m => {
                        const direction = m.isFromAdmin ? 'outgoing' : 'incoming';
                        html += `
                            <div class="msg-row ${direction}">
                                <div class="msg-bubble">
                                    <div>${m.messageText}</div>
                                    <div class="msg-meta">
                                        <span>${m.timestamp}</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    threadEl.innerHTML = html;

                    if (wasScrolledToBottom || threadEl.dataset.initialized !== "true") {
                        threadEl.scrollTop = threadEl.scrollHeight;
                        threadEl.dataset.initialized = "true";
                    }
                });
        }

        function handleReplyKeydown(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendReply();
            }
        }

        function sendReply() {
            const inputEl = document.getElementById('replyInput');
            const message = inputEl.value.trim();
            if (!message || !currentSessionId) return;

            fetch('/Admin/SendAdminReply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `sessionId=${currentSessionId}&message=${encodeURIComponent(message)}`
            }).then(res => {
                if (res.ok) {
                    inputEl.value = '';
                    loadMessages();
                    loadSessions();
                }
            });
        }
    </script>
}
