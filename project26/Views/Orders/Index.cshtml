@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Orders";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-block">
        <h1 class="page-title">Orders</h1>
        <p class="page-subtitle">Track and manage all customer orders.</p>
    </div>
    <button class="btn-primary" onclick="openOrderModal('add')">
        <i data-lucide="plus" style="width:15px;height:15px;"></i>
        Add Order
    </button>
</div>

<!-- Stats Strip -->
<div class="crud-stat-strip">
    <div class="crud-stat">
        <span class="crud-stat-val" id="stat-ord-total">8</span>
        <span class="crud-stat-label">Total</span>
    </div>
    <div class="crud-stat">
        <span class="crud-stat-val" style="color:#10b981;" id="stat-ord-completed">4</span>
        <span class="crud-stat-label">Completed</span>
    </div>
    <div class="crud-stat">
        <span class="crud-stat-val" style="color:#f59e0b;" id="stat-ord-pending">2</span>
        <span class="crud-stat-label">Pending</span>
    </div>
    <div class="crud-stat">
        <span class="crud-stat-val" style="color:#8b5cf6;" id="stat-ord-processing">1</span>
        <span class="crud-stat-label">Processing</span>
    </div>
    <div class="crud-stat">
        <span class="crud-stat-val" style="color:#ec4899;" id="stat-ord-cancelled">1</span>
        <span class="crud-stat-label">Cancelled</span>
    </div>
</div>

<!-- Search + Filter -->
<div class="crud-toolbar">
    <div class="header-search" style="flex:1; max-width:360px;">
        <i data-lucide="search" class="search-icon"></i>
        <input type="text" placeholder="Search by customer or product..."
               class="search-input" id="order-search" oninput="filterOrders()" />
    </div>
    <select class="time-select" id="filter-ord-status" onchange="filterOrders()">
        <option value="">All Status</option>
        <option value="Completed">Completed</option>
        <option value="Pending">Pending</option>
        <option value="Processing">Processing</option>
        <option value="Cancelled">Cancelled</option>
    </select>
    <select class="time-select" id="filter-ord-sort" onchange="filterOrders()">
        <option value="newest">Newest First</option>
        <option value="oldest">Oldest First</option>
        <option value="highest">Highest Amount</option>
        <option value="lowest">Lowest Amount</option>
    </select>
</div>

<!-- Orders Table -->
<div class="panel" style="padding:0; overflow:hidden;">
    <div class="table-wrap">
        <table class="orders-table" id="orders-table" style="table-layout:fixed;">
            <colgroup>
                <col style="width:90px" />
                <col style="width:170px" />
                <col style="width:180px" />
                <col style="width:120px" />
                <col style="width:110px" />
                <col style="width:120px" />
                <col style="width:130px" />
                <col style="width:130px" />
            </colgroup>
            <thead>
                <tr>
                    <th>ORDER ID</th>
                    <th>CUSTOMER</th>
                    <th>PRODUCT</th>
                    <th>DATE</th>
                    <th>QTY</th>
                    <th>AMOUNT</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody id="orders-tbody">
                <!-- Injected by JS -->
            </tbody>
        </table>
    </div>
</div>

<!-- ── ADD / EDIT ORDER MODAL ─────────────────────────── -->
<div class="modal-overlay" id="order-modal" onclick="closeOrderModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()" style="max-width:580px;">
        <div class="modal-header">
            <h3 class="modal-title" id="order-modal-title">Add Order</h3>
            <button class="modal-close" onclick="closeOrderModal(null)">
                <i data-lucide="x"></i>
            </button>
        </div>
        <form id="order-form" onsubmit="saveOrder(event)">
            <input type="hidden" id="ord-edit-id" value="" />
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Customer Name</label>
                    <input type="text" class="form-input" id="ord-customer"
                           placeholder="e.g. Jane Cooper" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Customer Email</label>
                    <input type="email" class="form-input" id="ord-email"
                           placeholder="e.g. jane@email.com" />
                </div>
                <div class="form-group" style="grid-column:1/-1;">
                    <label class="form-label">Product</label>
                    <select class="form-input" id="ord-product" required>
                        <option value="">Select product</option>
                        <option value="Vitamin C Serum">Vitamin C Serum</option>
                        <option value="Hydra Boost Cream">Hydra Boost Cream</option>
                        <option value="Retinol Night Oil">Retinol Night Oil</option>
                        <option value="SPF 50 Sunscreen">SPF 50 Sunscreen</option>
                        <option value="Rose Toner">Rose Toner</option>
                        <option value="Peptide Eye Cream">Peptide Eye Cream</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Quantity</label>
                    <input type="number" class="form-input" id="ord-qty"
                           placeholder="1" min="1" value="1" required oninput="calcTotal()" />
                </div>
                <div class="form-group">
                    <label class="form-label">Unit Price ($)</label>
                    <input type="number" class="form-input" id="ord-price"
                           placeholder="0.00" min="0" step="0.01" required oninput="calcTotal()" />
                </div>
                <div class="form-group">
                    <label class="form-label">Total Amount ($)</label>
                    <input type="text" class="form-input" id="ord-total"
                           placeholder="0.00" readonly
                           style="background:rgba(255,255,255,0.02);color:#10b981;font-weight:700;" />
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select class="form-input" id="ord-status">
                        <option value="Pending">Pending</option>
                        <option value="Processing">Processing</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-ghost" onclick="closeOrderModal(null)">Cancel</button>
                <button type="submit" class="btn-primary" id="ord-save-btn">
                    <i data-lucide="save" style="width:14px;height:14px;"></i>
                    Save Order
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ── VIEW ORDER DETAIL MODAL ────────────────────────── -->
<div class="modal-overlay" id="order-view-modal" onclick="closeViewModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()" style="max-width:500px;">
        <div class="modal-header">
            <h3 class="modal-title">Order Details</h3>
            <button class="modal-close" onclick="closeViewModal(null)">
                <i data-lucide="x"></i>
            </button>
        </div>
        <div id="order-detail-body" style="display:flex;flex-direction:column;gap:14px;">
            <!-- Injected by JS -->
        </div>
        <div class="modal-footer" style="margin-top:24px;">
            <button class="btn-ghost" onclick="closeViewModal(null)">Close</button>
        </div>
    </div>
</div>

<!-- ── DELETE CONFIRM MODAL ───────────────────────────── -->
<div class="modal-overlay" id="ord-delete-modal" onclick="closeDeleteOrdModal(event)">
    <div class="modal-box modal-sm" onclick="event.stopPropagation()">
        <div class="delete-icon-wrap">
            <i data-lucide="trash-2" style="width:30px;height:30px;color:#ec4899;"></i>
        </div>
        <h3 class="modal-title" style="text-align:center;margin-bottom:8px;">Delete Order?</h3>
        <p style="text-align:center;font-size:0.83rem;color:var(--text-secondary);margin-bottom:6px;">
            You are about to delete order:
        </p>
        <p id="ord-del-label"
           style="text-align:center;font-size:0.9rem;font-weight:700;color:#ec4899;margin-bottom:20px;"></p>
        <p style="text-align:center;font-size:0.78rem;color:var(--text-muted);margin-bottom:24px;">
            This action cannot be undone.
        </p>
        <input type="hidden" id="ord-del-id" />
        <div class="modal-footer" style="justify-content:center;">
            <button class="btn-ghost" onclick="closeDeleteOrdModal(null)">Cancel</button>
            <button class="btn-danger" onclick="confirmDeleteOrder()">
                <i data-lucide="trash-2" style="width:14px;height:14px;"></i>
                Yes, Delete
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Static Data ──────────────────────────────────────────
let orders = [
    { id: 7821, customer: "Jane Cooper",   email: "jane@email.com",   product: "Vitamin C Serum",   qty: 2, price: 34.99, status: "Completed",  date: "Oct 24, 2025" },
    { id: 7820, customer: "Alex Martin",   email: "alex@email.com",   product: "Retinol Night Oil",  qty: 1, price: 49.00, status: "Pending",     date: "Oct 23, 2025" },
    { id: 7819, customer: "Sarah Lee",     email: "sarah@email.com",  product: "Hydra Boost Cream",  qty: 3, price: 28.50, status: "Completed",  date: "Oct 22, 2025" },
    { id: 7818, customer: "Mike Johnson",  email: "mike@email.com",   product: "SPF 50 Sunscreen",   qty: 2, price: 19.99, status: "Cancelled",  date: "Oct 21, 2025" },
    { id: 7817, customer: "Emma Wilson",   email: "emma@email.com",   product: "Peptide Eye Cream",  qty: 1, price: 42.00, status: "Completed",  date: "Oct 20, 2025" },
    { id: 7816, customer: "Liam Brown",    email: "liam@email.com",   product: "Rose Toner",         qty: 4, price: 15.00, status: "Processing", date: "Oct 19, 2025" },
    { id: 7815, customer: "Olivia Davis",  email: "olivia@email.com", product: "Vitamin C Serum",   qty: 1, price: 34.99, status: "Pending",     date: "Oct 18, 2025" },
    { id: 7814, customer: "Noah Garcia",   email: "noah@email.com",   product: "Retinol Night Oil",  qty: 2, price: 49.00, status: "Completed",  date: "Oct 17, 2025" },
];
let ordNextId = 7822;

// ── Status Badge ─────────────────────────────────────────
function statusBadge(s) {
    const map = {
        Completed:  'badge-completed',
        Pending:    'badge-pending',
        Cancelled:  'badge-cancelled',
        Processing: 'badge-processing',
    };
    return `<span class="badge ${map[s] || ''}">${s}</span>`;
}

// ── Render ───────────────────────────────────────────────
function renderOrders(data) {
    const tbody = document.getElementById('orders-tbody');
    if (!data.length) {
        tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;padding:44px;color:var(--text-muted);">No orders found.</td></tr>`;
        updateOrdStats();
        return;
    }
    tbody.innerHTML = data.map(o => {
        const total = (o.qty * o.price).toFixed(2);
        return `
        <tr data-customer="${o.customer.toLowerCase()}" data-product="${o.product.toLowerCase()}" data-status="${o.status}">
            <td class="order-id">#${o.id}</td>
            <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                <div style="font-weight:600;color:#fff;font-size:0.84rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${o.customer}</div>
                <div style="font-size:0.71rem;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${o.email}</div>
            </td>
            <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.83rem;color:var(--text-secondary);">${o.product}</td>
            <td style="font-size:0.78rem;color:var(--text-muted);white-space:nowrap;">${o.date}</td>
            <td style="text-align:center;font-weight:600;">${o.qty}</td>
            <td style="font-weight:700;color:#10b981;white-space:nowrap;">$${total}</td>
            <td style="white-space:nowrap;">${statusBadge(o.status)}</td>
            <td>
                <div style="display:flex;gap:6px;align-items:center;">
                    <button class="action-btn" onclick="openViewModal(${o.id})" title="View"
                            style="background:rgba(16,185,129,0.12);color:#10b981;border:1px solid rgba(16,185,129,0.2);">
                        <i data-lucide="eye" style="width:14px;height:14px;"></i>
                    </button>
                    <button class="action-btn action-edit" onclick="openOrderModal('edit', ${o.id})" title="Edit">
                        <i data-lucide="pencil" style="width:14px;height:14px;"></i>
                    </button>
                    <button class="action-btn action-delete" onclick="openDeleteOrdModal(${o.id})" title="Delete">
                        <i data-lucide="trash-2" style="width:14px;height:14px;"></i>
                    </button>
                </div>
            </td>
        </tr>`;
    }).join('');
    lucide.createIcons();
    updateOrdStats();
}

function updateOrdStats() {
    document.getElementById('stat-ord-total').textContent      = orders.length;
    document.getElementById('stat-ord-completed').textContent  = orders.filter(o => o.status === 'Completed').length;
    document.getElementById('stat-ord-pending').textContent    = orders.filter(o => o.status === 'Pending').length;
    document.getElementById('stat-ord-processing').textContent = orders.filter(o => o.status === 'Processing').length;
    document.getElementById('stat-ord-cancelled').textContent  = orders.filter(o => o.status === 'Cancelled').length;
}

// ── Filter & Sort ────────────────────────────────────────
function filterOrders() {
    const q   = document.getElementById('order-search').value.toLowerCase();
    const st  = document.getElementById('filter-ord-status').value;
    const srt = document.getElementById('filter-ord-sort').value;

    let filtered = orders.filter(o =>
        (!q  || o.customer.toLowerCase().includes(q) || o.product.toLowerCase().includes(q)) &&
        (!st || o.status === st)
    );

    if (srt === 'highest') filtered.sort((a,b) => (b.qty*b.price) - (a.qty*a.price));
    else if (srt === 'lowest')  filtered.sort((a,b) => (a.qty*a.price) - (b.qty*b.price));
    else if (srt === 'oldest')  filtered.sort((a,b) => a.id - b.id);
    else filtered.sort((a,b) => b.id - a.id);

    renderOrders(filtered);
}

// ── Calc Total ───────────────────────────────────────────
function calcTotal() {
    const qty   = parseFloat(document.getElementById('ord-qty').value)   || 0;
    const price = parseFloat(document.getElementById('ord-price').value) || 0;
    document.getElementById('ord-total').value = '$' + (qty * price).toFixed(2);
}

// ── Add / Edit Modal ─────────────────────────────────────
function openOrderModal(mode, id) {
    document.getElementById('order-modal').classList.add('open');
    if (mode === 'add') {
        document.getElementById('order-modal-title').textContent = 'Add Order';
        document.getElementById('ord-save-btn').textContent      = 'Save Order';
        document.getElementById('order-form').reset();
        document.getElementById('ord-edit-id').value  = '';
        document.getElementById('ord-total').value    = '$0.00';
    } else {
        const o = orders.find(x => x.id === id);
        document.getElementById('order-modal-title').textContent = 'Edit Order';
        document.getElementById('ord-save-btn').textContent      = 'Update Order';
        document.getElementById('ord-edit-id').value    = o.id;
        document.getElementById('ord-customer').value   = o.customer;
        document.getElementById('ord-email').value      = o.email;
        document.getElementById('ord-product').value    = o.product;
        document.getElementById('ord-qty').value        = o.qty;
        document.getElementById('ord-price').value      = o.price;
        document.getElementById('ord-total').value      = '$' + (o.qty * o.price).toFixed(2);
        document.getElementById('ord-status').value     = o.status;
    }
    lucide.createIcons();
}

function closeOrderModal(e) {
    if (!e || e.target === document.getElementById('order-modal'))
        document.getElementById('order-modal').classList.remove('open');
}

function saveOrder(e) {
    e.preventDefault();
    const id  = document.getElementById('ord-edit-id').value;
    const qty = parseInt(document.getElementById('ord-qty').value);
    const price = parseFloat(document.getElementById('ord-price').value);
    const entry = {
        id:       id ? parseInt(id) : ordNextId++,
        customer: document.getElementById('ord-customer').value.trim(),
        email:    document.getElementById('ord-email').value.trim(),
        product:  document.getElementById('ord-product').value,
        qty, price,
        status:   document.getElementById('ord-status').value,
        date:     id ? orders.find(o => o.id === parseInt(id)).date
                     : new Date().toLocaleDateString('en-US', { month:'short', day:'2-digit', year:'numeric' }),
    };
    if (id) { orders[orders.findIndex(o => o.id === parseInt(id))] = entry; }
    else     { orders.unshift(entry); }
    closeOrderModal(null);
    renderOrders(orders);
    showToast(id ? 'Order updated!' : 'Order added!');
}

// ── View Detail Modal ────────────────────────────────────
function openViewModal(id) {
    const o = orders.find(x => x.id === id);
    const total = (o.qty * o.price).toFixed(2);
    document.getElementById('order-detail-body').innerHTML = `
        <div class="ord-detail-row"><span class="ord-detail-label">Order ID</span><span class="order-id">#${o.id}</span></div>
        <div class="ord-detail-row"><span class="ord-detail-label">Customer</span><span style="color:#fff;font-weight:600;">${o.customer}</span></div>
        <div class="ord-detail-row"><span class="ord-detail-label">Email</span><span style="color:var(--text-secondary);">${o.email || '—'}</span></div>
        <div class="ord-detail-row"><span class="ord-detail-label">Product</span><span style="color:var(--text-secondary);">${o.product}</span></div>
        <div class="ord-detail-row"><span class="ord-detail-label">Quantity</span><span style="color:#fff;font-weight:600;">${o.qty}</span></div>
        <div class="ord-detail-row"><span class="ord-detail-label">Unit Price</span><span style="color:#fff;">$${o.price.toFixed(2)}</span></div>
        <div class="ord-detail-row"><span class="ord-detail-label">Total Amount</span><span style="color:#10b981;font-weight:800;font-size:1.1rem;">$${total}</span></div>
        <div class="ord-detail-row"><span class="ord-detail-label">Date</span><span style="color:var(--text-muted);">${o.date}</span></div>
        <div class="ord-detail-row"><span class="ord-detail-label">Status</span>${statusBadge(o.status)}</div>
    `;
    document.getElementById('order-view-modal').classList.add('open');
    lucide.createIcons();
}

function closeViewModal(e) {
    if (!e || e.target === document.getElementById('order-view-modal'))
        document.getElementById('order-view-modal').classList.remove('open');
}

// ── Delete Modal ─────────────────────────────────────────
function openDeleteOrdModal(id) {
    document.getElementById('ord-del-id').value       = id;
    document.getElementById('ord-del-label').textContent = `#${id}`;
    document.getElementById('ord-delete-modal').classList.add('open');
    lucide.createIcons();
}

function closeDeleteOrdModal(e) {
    if (!e || e.target === document.getElementById('ord-delete-modal'))
        document.getElementById('ord-delete-modal').classList.remove('open');
}

function confirmDeleteOrder() {
    const id = parseInt(document.getElementById('ord-del-id').value);
    orders   = orders.filter(o => o.id !== id);
    closeDeleteOrdModal(null);
    renderOrders(orders);
    showToast('Order deleted!', 'error');
}

// ── Toast ─────────────────────────────────────────────────
function showToast(msg, type = 'success') {
    const t = document.createElement('div');
    t.className   = 'toast-msg ' + type;
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.classList.add('show'), 10);
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 400); }, 2600);
}

// ── Init ──────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    renderOrders(orders);
    lucide.createIcons();
});
</script>
}
