@model project26.Models.User

@{
    ViewData["Title"] = "Verify Account - E-World";
}

<div class="auth-wrapper">
    <div class="site-card" style="width:100%;max-width:420px; box-shadow: 0 10px 25px rgba(0,0,0,0.05);">

        <!-- Header -->
        <div class="site-heading">
            <div style="width: 60px; height: 60px; background: #fff8f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px; color: var(--accent-pink);">
                <i data-lucide="shield-check" style="width: 30px; height: 30px;"></i>
            </div>
            <h2>Verify Account</h2>
            <p>We've sent a 6-digit code to your email</p>
        </div>

        <form asp-action="Verify" method="post" novalidate>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2" style="background: #fdf2f2; border: 1px solid #f8d7da; color: #dc3545; border-radius: 4px; font-size: 0.85rem; padding: 12px 16px; margin-bottom: 20px;">
                    <i data-lucide="alert-circle" style="width: 18px; height: 18px;"></i>
                    @ViewBag.Error
                </div>
            }

            <!-- Code Input -->
            <div style="margin-bottom:24px;">
                <label class="site-label">Verification Code</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i data-lucide="key" style="width:16px;height:16px;"></i>
                    </span>
                    <input name="verifycode" type="number" class="form-control"
                           placeholder="Enter 6-digit code" required 
                           style="letter-spacing: 5px; font-weight: 700; text-align: center;"/>
                </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-site btn-site-primary">
                VERIFY ACCOUNT
            </button>

            <div style="margin-top:25px; text-align:center;">
                <p style="font-size:0.9rem;color:var(--text-secondary);">
                    Didn't receive the code?
                    <a href="#" style="color: var(--accent-pink); font-weight:700;">Resend</a>
                </p>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
}