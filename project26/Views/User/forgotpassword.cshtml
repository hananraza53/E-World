@{
    ViewData["Title"] = "Forgot Password - E-World";
}

<div class="auth-wrapper">
    <div class="site-card" style="width:100%;max-width:420px; box-shadow: 0 10px 25px rgba(0,0,0,0.05);">

        <!-- Header -->
        <div class="site-heading">
            <div style="width: 60px; height: 60px; background: #fff8f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px; color: var(--accent-pink);">
                <i data-lucide="help-circle" style="width: 30px; height: 30px;"></i>
            </div>
            <h2>Forgot Password?</h2>
            <p>Enter your email to receive a reset code</p>
        </div>

        <form asp-action="ForgotPassword" method="post" novalidate>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2" style="background: #fdf2f2; border: 1px solid #f8d7da; color: #dc3545; border-radius: 4px; font-size: 0.85rem; padding: 12px 16px; margin-bottom: 20px;">
                    <i data-lucide="alert-circle" style="width: 18px; height: 18px;"></i>
                    @ViewBag.Error
                </div>
            }

            <!-- Email -->
            <div style="margin-bottom:24px;">
                <label class="site-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i data-lucide="mail" style="width:16px;height:16px;"></i>
                    </span>
                    <input name="uemail" type="email" class="form-control"
                           placeholder="Enter your registered email" required />
                </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-site btn-site-primary">
                SEND RESET CODE
            </button>

            <div style="margin-top:25px; text-align:center;">
                <a asp-action="login" style="font-size:0.9rem;color:var(--text-secondary); display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <i data-lucide="arrow-left" style="width: 16px;"></i> Back to Login
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
}