@using project26.Models
@model User

@{
    ViewData["Title"] = "Login - E-World";
}

<div class="auth-wrapper">
    <div class="site-card" style="width:100%;max-width:420px; box-shadow: 0 10px 25px rgba(0,0,0,0.05);">

        <!-- Header -->
        <div class="site-heading">
            <div style="width: 60px; height: 60px; background: #fff8f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px; color: var(--accent-pink);">
                <i data-lucide="user" style="width: 30px; height: 30px;"></i>
            </div>
            <h2>Welcome Back</h2>
            <p>Login to your E-World account</p>
        </div>

        <form asp-action="login" method="post" novalidate>

            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:16px;"></div>

            <!-- Email -->
            <div style="margin-bottom:18px;">
                <label class="site-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i data-lucide="mail" style="width:16px;height:16px;"></i>
                    </span>
                    <input name="uemail" type="email" class="form-control"
                           placeholder="Enter your email" required />
                </div>
                <span asp-validation-for="uemail" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div style="margin-bottom:18px;">
                <label class="site-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i data-lucide="lock" style="width:16px;height:16px;"></i>
                    </span>
                    <input name="upassword" type="password" class="form-control"
                           placeholder="Enter your password" required />
                </div>
                <span asp-validation-for="upassword" class="text-danger"></span>
            </div>

            <!-- Remember me + Forgot -->
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
                <div class="form-check" style="margin:0;">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label" for="rememberMe" style="font-size:0.85rem!important; color: var(--text-secondary) !important;">
                        Stay signed in
                    </label>
                </div>
                <a asp-controller="User" asp-action="ForgotPassword"
                   style="font-size:0.85rem; color: var(--accent-pink); font-weight: 600;">
                    Forgot password?
                </a>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-site btn-site-primary">
                SIGN IN
            </button>

            <div class="site-divider">
                <span style="background: #fff; padding: 0 15px; color: var(--text-muted); font-size: 12px; font-weight: 600;">OR</span>
            </div>

            <!-- Google Button (Improved) -->
            <a href="#" class="btn-site btn-site-ghost" style="display:flex;align-items:center;justify-content:center;gap:12px; border: 1px solid #e2e2e2;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                    <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z" />
                    <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z" />
                    <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z" />
                    <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z" />
                </svg>
                <span>Google</span>
            </a>

            <p style="text-align:center;font-size:0.9rem;color:var(--text-secondary); margin-top: 30px;">
                New to E-World?
                <a asp-controller="User" asp-action="Register"
                   style="color: var(--accent-pink); font-weight:700;">
                    Join now
                </a>
            </p>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
}